<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../Strings/*.json" LogicalName="Fallery.Strings.%(Filename)%(Extension)" />
    <Compile Include="../../Services/AppText.cs" Link="Services/AppText.cs" />
    <Compile Include="../../Services/AppIdentity.cs" Link="Services/AppIdentity.cs" />
    <Compile Include="../../Services/MediaDates.cs" Link="MediaDates.cs" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="../../Controls/LiveText.cs" Link="Controls/LiveText.cs" />
    <Compile Include="../../Controls/Localization.cs" Link="Controls/Localization.cs" />
    <Page Include="../../Controls/MediaTile.xaml" Link="Controls/MediaTile.xaml" />
    <Page Include="../../Themes/Icons.xaml" Link="Themes/Icons.xaml" />
    <Content Include="../../Assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../Controls/MediaTile.xaml.cs" Link="Controls/MediaTile.xaml.cs" />
    <Compile Include="../../Controls/FluentIcons.cs" Link="Controls/FluentIcons.cs" />
    <Compile Include="../../Models/MediaFile.cs" Link="Models/MediaFile.cs" />
    <Compile Include="../../Models/MediaItem.cs" Link="Models/MediaItem.cs" />
    <Compile Include="../../Models/FolderEntry.cs" Link="Models/FolderEntry.cs" />
    <Compile Include="../../Services/FolderScanner.cs" Link="Services/FolderScanner.cs" />
    <Compile Include="../../Services/BoundedCache.cs" Link="Services/BoundedCache.cs" />
    <Compile Include="../../Services/MediaCache.cs" Link="Services/MediaCache.cs" />
    <Compile Include="../../Services/ThumbnailDiskCache.cs" Link="Services/ThumbnailDiskCache.cs" />
    <Compile Include="../../Services/VideoThumbnail.cs" Link="Services/VideoThumbnail.cs" />
    <Compile Include="../../Services/MediaProbe.cs" Link="Services/MediaProbe.cs" />
    <Compile Include="../../Layouts/MasonryLayout.cs" Link="Layouts/MasonryLayout.cs" />
    <Compile Include="../../Layouts/MasonryGeometry.cs" Link="Layouts/MasonryGeometry.cs" />
  </ItemGroup>
</Project>
