<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layouts="using:Fallery.Layouts"
    xmlns:controls="using:Fallery.Controls"
    xmlns:models="using:Fallery.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Fallery">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="FolderIconBrush" Color="#E8A923" />
                        <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="FolderIconBrush" Color="#F2C24F" />
                        <SolidColorBrush x:Key="DividerBrush" Color="#19FFFFFF" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <DataTemplate x:Key="SearchResultTemplate">
                    <Grid Padding="4,7" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Path}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{Binding Glyph}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Parent}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="IdenticalImageResultTemplate">
                    <Grid Padding="4,7" ColumnSpacing="12" ToolTipService.ToolTip="{Binding Path}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="64" Height="48" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                            <controls:FileThumbnail File="{Binding PreviewFile}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Parent}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="FolderScopeTemplate">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTipService.ToolTip="{Binding}" />
                </DataTemplate>
                <!-- 图标开关用中性底色和图标明暗区分状态，保留原生 ToggleButton 的交互与焦点处理。 -->
                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SubtleFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SubtleFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonForeground" Color="{ThemeResource TextFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource TextFillColorTertiary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource TextFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="7" />
                    <Setter Property="MinWidth" Value="30" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="7" />
                    <Setter Property="MinWidth" Value="30" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <controls:FolderIconConverter x:Key="FolderIconConverter" />
                <controls:NonEmptyTextVisibilityConverter x:Key="NonEmptyTextVisibilityConverter" />
                <Style x:Key="DetailsLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="DetailsValueStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="LineHeight" Value="20" />
                    <Setter Property="IsTextSelectionEnabled" Value="True" />
                </Style>
                <Style x:Key="DetailsCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="14" />
                </Style>
                <DataTemplate x:Key="PlaylistTextTemplate" x:DataType="models:MediaItem">
                    <TextBlock Text="{x:Bind Name}" FontSize="12" TextWrapping="Wrap" MaxLines="2" Margin="0,8"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                </DataTemplate>
                <!-- 地址栏子目录菜单按菜单密度排列，默认 ListView 行高和弹出框内边距过大。 -->
                <Style x:Key="AddressMenuPresenterStyle" TargetType="FlyoutPresenter">
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="NavigationMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                </Style>
                <Style x:Key="PlaybackRateMenuPresenterStyle" TargetType="MenuFlyoutPresenter"
                       BasedOn="{StaticResource NavigationMenuPresenterStyle}">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Width" Value="80" />
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="AddressMenuItemStyle" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
                <DataTemplate x:Key="AddressMenuItemTemplate" x:DataType="models:FolderEntry">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconFolderFilled}" FontSize="14" Foreground="{ThemeResource FolderIconBrush}"
                                      Visibility="{Binding Path, Converter={StaticResource FolderIconConverter}, ConverterParameter=Folder}" />
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconDrive}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{Binding Path, Converter={StaticResource FolderIconConverter}, ConverterParameter=Drive}" />
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPictures}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="{Binding Path, Converter={StaticResource FolderIconConverter}, ConverterParameter=Pictures}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
                <Style x:Key="IconDropDownStyle" TargetType="DropDownButton">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="7,7,3,7" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BackdropTint" Grid.RowSpan="3" IsHitTestVisible="False"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.7" />

        <TitleBar x:Name="AppTitleBar" Title="Fallery" Height="48"
                  Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <x:Double x:Key="TitleBarIconMaxWidth">20</x:Double>
                <x:Double x:Key="TitleBarIconMaxHeight">20</x:Double>
                <Thickness x:Key="TitleBarIconMargin">0,0,10,0</Thickness>
                <!-- 工具栏按钮禁用时只变灰图标，不显示底色块，否则后退/前进看起来像留了很大的内边距。 -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </TitleBar.Resources>
            <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/FalleryTitleBar.png" /></TitleBar.IconSource>
            <TitleBar.Content>
                <Grid Margin="4,0,8,0">
                    <Grid x:Name="GalleryToolbar" Visibility="{x:Bind GalleryChromeVisibility(ViewerState.IsOpen, GalleryState.DisplayMode), Mode=OneWay}" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SidebarToggle" Style="{StaticResource IconButtonStyle}" Click="SidebarToggle_Click"
                                ToolTipService.ToolTip="显示 / 隐藏文件树" AutomationProperties.Name="显示或隐藏文件树">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSidebar}" />
                        </Button>
                        <Button x:Name="BackButton" Grid.Column="1" IsEnabled="{x:Bind GalleryState.CanGoBack, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}" Click="Back_Click" ToolTipService.ToolTip="后退 (Alt+← / S)" AutomationProperties.Name="后退">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconBack}" />
                        </Button>
                        <Button x:Name="ForwardButton" Grid.Column="2" IsEnabled="{x:Bind GalleryState.CanGoForward, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}" Click="Forward_Click" ToolTipService.ToolTip="前进 (Alt+→)" AutomationProperties.Name="前进">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconForward}" />
                        </Button>
                        <Button x:Name="UpButton" Grid.Column="3" IsEnabled="{x:Bind GalleryState.CanGoUp, Mode=OneWay}"
                                Style="{StaticResource IconButtonStyle}" Click="Up_Click" ToolTipService.ToolTip="上级目录 (Alt+↑ / W)" AutomationProperties.Name="上级目录">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconUp}" />
                        </Button>
                        <Border x:Name="AddressFrame" Grid.Column="4" Margin="8,0,0,0" Height="32" VerticalAlignment="Center" CornerRadius="6"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource ControlFillColorDefaultBrush}" Tapped="AddressFrame_Tapped">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="28" Padding="4" Margin="2,0,0,0" Click="AddressChildren_Click"
                                        ToolTipService.ToolTip="选择磁盘或图片目录" AutomationProperties.Name="选择磁盘">
                                    <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconFolderFilled}" Foreground="{ThemeResource FolderIconBrush}" />
                                </Button>
                                <ScrollViewer x:Name="AddressScroller" Grid.Column="1" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" SizeChanged="AddressScroller_SizeChanged">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <StackPanel x:Name="AddressSegments" Orientation="Horizontal" SizeChanged="AddressScroller_SizeChanged" />
                                        <Border Width="32" Background="Transparent" ToolTipService.ToolTip="编辑完整路径 (Ctrl+L / Alt+D)" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBox x:Name="AddressEditor" Grid.Column="1" Visibility="Collapsed" MinHeight="0" Padding="4,3" BorderThickness="0"
                                         FontSize="13" Background="Transparent" PlaceholderText="输入文件夹路径"
                                         AutomationProperties.Name="文件夹地址" KeyDown="AddressEditor_KeyDown" LostFocus="AddressEditor_LostFocus" />
                                <Button x:Name="AddressHistoryButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="28" Padding="6,5"
                                        Click="AddressHistory_Click" ToolTipService.ToolTip="最近访问的位置" AutomationProperties.Name="最近访问的位置">
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconExpand}" FontSize="12" />
                                </Button>
                                <Button x:Name="AddressRefreshButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="28" Padding="5" Margin="0,0,2,0"
                                        Click="Refresh_Click" ToolTipService.ToolTip="刷新 (F5)" AutomationProperties.Name="刷新目录">
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconRefresh}" FontSize="15" />
                                </Button>
                                <Button x:Name="AddressGoButton" Grid.Column="3" Visibility="Collapsed" Style="{StaticResource IconButtonStyle}" MinWidth="0" MinHeight="28" Padding="5" Margin="0,0,2,0"
                                        Click="AddressGo_Click" ToolTipService.ToolTip="转到此地址 (Enter)" AutomationProperties.Name="转到此地址">
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconForward}" FontSize="15" />
                                </Button>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
                            <Button x:Name="SearchButton" Style="{StaticResource IconButtonStyle}" Click="Search_Click"
                                    ToolTipService.ToolTip="全电脑搜索 (Ctrl+F)" AutomationProperties.Name="全电脑搜索">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSearch}" />
                            </Button>
                            <Button x:Name="FavoriteButton" Style="{StaticResource IconButtonStyle}" Click="Favorite_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="收藏当前文件夹" AutomationProperties.Name="收藏当前文件夹">
                                <FontIcon x:Name="FavoriteIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconBookmark}" />
                            </Button>
                            <Button x:Name="OpenFolderButton" Style="{StaticResource IconButtonStyle}" Click="OpenFolder_Click"
                                    ToolTipService.ToolTip="打开文件夹 (Ctrl+O)" AutomationProperties.Name="打开文件夹">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></Button.KeyboardAccelerators>
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconOpenFolder}" />
                            </Button>
                            <Rectangle Width="1" Height="18" Margin="4,0" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center" />
                            <DropDownButton Style="{StaticResource IconDropDownStyle}" AutomationProperties.Name="排序" ToolTipService.ToolTip="排序（文件夹优先）">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSort}" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True"
                                                MenuFlyoutPresenterStyle="{StaticResource NavigationMenuPresenterStyle}">
                                        <RadioMenuFlyoutItem x:Name="SortTakenItem" Text="拍摄日期" Tag="Taken" GroupName="SortField" Click="SortField_Click"
                                                            ToolTipService.ToolTip="照片使用 EXIF 拍摄日期，视频使用媒体日期；无日期排在末尾">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortTaken}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortCreatedItem" Text="创建日期" Tag="Created" GroupName="SortField" Click="SortField_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortCreated}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortNameItem" Text="名称" Tag="Name" GroupName="SortField" IsChecked="True" Click="SortField_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortName}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortModifiedItem" Text="修改日期" Tag="Modified" GroupName="SortField" Click="SortField_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortModified}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortSizeItem" Text="文件大小" Tag="Size" GroupName="SortField" Click="SortField_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortSize}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="SortAscendingItem" Text="升序" Tag="Ascending" GroupName="SortDirection" IsChecked="True" Click="SortDirection_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAscending}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="SortDescendingItem" Text="降序" Tag="Descending" GroupName="SortDirection" Click="SortDirection_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconDescending}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="FilterMenuButton" Style="{StaticResource IconDropDownStyle}" AutomationProperties.Name="筛选" ToolTipService.ToolTip="筛选媒体与子文件夹">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFilter}" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True"
                                                MenuFlyoutPresenterStyle="{StaticResource NavigationMenuPresenterStyle}">
                                        <RadioMenuFlyoutItem x:Name="FilterAllItem" Text="所有媒体" Tag="All" GroupName="MediaFilter" IsChecked="True" Click="MediaFilter_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAllMedia}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="FilterPhotosItem" Text="图片" Tag="Photos" GroupName="MediaFilter" Click="MediaFilter_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconImage}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="FilterVideosItem" Text="视频" Tag="Videos" GroupName="MediaFilter" Click="MediaFilter_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconVideo}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="FilterAudioItem" Text="音频" Tag="Audio" GroupName="MediaFilter" Click="MediaFilter_Click">
                                            <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAudio}" /></RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <RadioMenuFlyoutItem x:Name="ShowSubfoldersItem" Text="显示子文件夹" Tag="Show" GroupName="Subfolders" IsChecked="True" Click="Subfolders_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFolder}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="HideSubfoldersItem" Text="隐藏子文件夹" Tag="Hide" GroupName="Subfolders" Click="Subfolders_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFolderHidden}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="ShowHiddenItem" Text="显示隐藏的项目" Click="ShowHidden_Click">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconHiddenItems}" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton x:Name="ViewMenuButton" Style="{StaticResource IconDropDownStyle}" ToolTipService.ToolTip="视图"
                                            AutomationProperties.Name="视图模式与文件名">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{x:Bind DisplayModeGlyph(GalleryState.DisplayMode), Mode=OneWay}" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True"
                                                MenuFlyoutPresenterStyle="{StaticResource NavigationMenuPresenterStyle}">
                                        <RadioMenuFlyoutItem x:Name="JustifiedModeItem" Text="自适应视图" Tag="Justified" GroupName="DisplayMode" Click="DisplayMode_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconJustified}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="MasonryModeItem" Text="瀑布视图" Tag="Masonry" GroupName="DisplayMode" IsChecked="True" Click="DisplayMode_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconMasonry}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="LargeIconsModeItem" Text="网格视图" Tag="LargeIcons" GroupName="DisplayMode" Click="DisplayMode_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconLargeIcons}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem x:Name="FilmstripModeItem" Text="大图 + 底部缩略图" Tag="Filmstrip" GroupName="DisplayMode" Click="DisplayMode_Click">
                                                <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFilmstrip}" /></RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="ShowFileNamesItem" Text="显示文件名" IsChecked="True" Click="ShowFileNames_Click">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFileNames}" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                        <ToggleMenuFlyoutItem x:Name="ShowCardsItem" Text="显示卡片背景" IsChecked="True" Click="ShowCards_Click">
                                                <ToggleMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconCards}" /></ToggleMenuFlyoutItem.Icon>
                                            </ToggleMenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ViewerToolbar" Visibility="{x:Bind ViewerChromeVisibility(ViewerState.IsOpen, GalleryState.DisplayMode), Mode=OneWay}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloseViewerButton" Style="{StaticResource IconButtonStyle}" Click="CloseViewer_Click"
                                ToolTipService.ToolTip="返回浏览 (Esc)" AutomationProperties.Name="关闭查看器">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconBack}" />
                        </Button>
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ViewerTitle" Text="{x:Bind ViewerState.Title, Mode=OneWay}"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ViewerCounter" Grid.Column="1" Text="{x:Bind FormatViewerCounter(ViewerState.Counter), Mode=OneWay}"
                                       VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Border Grid.Column="2" Width="{x:Bind CloseViewerButton.ActualWidth, Mode=OneWay}" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="SettingsButton" Grid.Column="1" Margin="2,0,0,0" Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind GalleryChromeVisibility(ViewerState.IsOpen, GalleryState.DisplayMode), Mode=OneWay}"
                            Click="Settings_Click" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSettings}" />
                    </Button>
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid x:Name="BrowserSurface" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="160" MaxWidth="480" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SidebarPanel" Background="Transparent" Padding="4,4,2,4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" MaxHeight="240" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="TreeToolbar" Margin="8,0,4,4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="文件夹" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="文件树设置" AutomationProperties.Name="文件树设置">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSettings}" />
                            <Button.Flyout>
                                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource NavigationMenuPresenterStyle}" Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
                                    <RadioMenuFlyoutItem x:Name="TreeSortNameItem" Text="名称" Tag="Name" GroupName="TreeSortField" IsChecked="True" Click="TreeSort_Click" />
                                    <RadioMenuFlyoutItem x:Name="TreeSortModifiedItem" Text="修改时间" Tag="Modified" GroupName="TreeSortField" Click="TreeSort_Click" />
                                    <MenuFlyoutSeparator />
                                    <RadioMenuFlyoutItem x:Name="TreeAscendingItem" Text="升序" Tag="Ascending" GroupName="TreeSortDirection" IsChecked="True" Click="TreeSort_Click" />
                                    <RadioMenuFlyoutItem x:Name="TreeDescendingItem" Text="降序" Tag="Descending" GroupName="TreeSortDirection" Click="TreeSort_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="TreeExclusionsItem" Text="管理排除的文件夹" Click="TreeExclusions_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="NewFolderButton" Style="{StaticResource IconButtonStyle}" IsEnabled="False" Click="NewFolder_Click"
                                ToolTipService.ToolTip="在当前目录新建文件夹" AutomationProperties.Name="新建文件夹">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconNewFolder}" />
                        </Button>
                        <Button x:Name="TreeTimeButton" Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="文件夹时间" AutomationProperties.Name="文件夹时间">
                            <FontIcon x:Name="TreeTimeIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortModified}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="True">
                                    <RadioMenuFlyoutItem x:Name="TreeTimeHiddenItem" Text="不显示" Tag="None" GroupName="TreeTime" Click="TreeTime_Click" />
                                    <RadioMenuFlyoutItem x:Name="TreeTimeModifiedItem" Text="修改时间" Tag="Modified" GroupName="TreeTime" Click="TreeTime_Click">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortModified}" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                    <RadioMenuFlyoutItem x:Name="TreeTimeCreatedItem" Text="创建时间" Tag="Created" GroupName="TreeTime" Click="TreeTime_Click">
                                        <RadioMenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconSortCreated}" /></RadioMenuFlyoutItem.Icon>
                                    </RadioMenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <TreeView x:Name="FavoritesTree" Grid.Row="1" SelectionMode="Single" ItemInvoked="FavoritesTree_ItemInvoked"
                          ContextRequested="FavoritesTree_ContextRequested" AutomationProperties.Name="收藏文件夹">
                    <TreeView.Resources><x:Double x:Key="TreeViewItemMinHeight">30</x:Double></TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Content.Path}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconBookmark}" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Content.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Content.ModifiedText}" ToolTipService.ToolTip="{Binding Content.TimeLabel}" Visibility="{Binding Content.ModifiedText, Converter={StaticResource NonEmptyTextVisibilityConverter}}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TreeView x:Name="FolderTree" Grid.Row="2" SelectionMode="Single" SizeChanged="FolderTree_SizeChanged"
                          ContextRequested="FolderTree_ContextRequested" Expanding="FolderTree_Expanding" ItemInvoked="FolderTree_ItemInvoked">
                    <TreeView.Resources>
                        <x:Double x:Key="TreeViewItemMinHeight">30</x:Double>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{Binding Content.Path}" DoubleTapped="FolderTreeItem_DoubleTapped">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconFolderFilled}" Foreground="{ThemeResource FolderIconBrush}"
                                              Visibility="{Binding Content, Converter={StaticResource FolderIconConverter}, ConverterParameter=Folder}" />
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconDrive}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{Binding Content, Converter={StaticResource FolderIconConverter}, ConverterParameter=Drive}" />
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPictures}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{Binding Content, Converter={StaticResource FolderIconConverter}, ConverterParameter=Pictures}" />
                                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconDesktop}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{Binding Content, Converter={StaticResource FolderIconConverter}, ConverterParameter=Desktop}" />
                                </Grid>
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Content.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Content.ModifiedText}" ToolTipService.ToolTip="{Binding Content.TimeLabel}" Visibility="{Binding Content.ModifiedText, Converter={StaticResource NonEmptyTextVisibilityConverter}}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Border x:Name="FolderTreeStickyHeader" Grid.Row="2" VerticalAlignment="Top" Margin="4,0,16,0"
                        Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="4"
                        PointerWheelChanged="FolderTreeStickyHeader_PointerWheelChanged">
                    <ItemsControl x:Name="FolderTreeStickyItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Tag="{Binding Node}" Click="StickyTreeCollapse_Click" Style="{StaticResource IconButtonStyle}"
                                            Width="28" Height="30" ToolTipService.ToolTip="{Binding CollapseLabel}" AutomationProperties.Name="{Binding CollapseLabel}">
                                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconExpand}" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="1" Tag="{Binding Node}" Click="StickyTreeNavigate_Click" Padding="4,0" MinWidth="0" Height="32"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="{Binding Entry.Path}" AutomationProperties.Name="{Binding Entry.Name}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource FolderIconBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Entry.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Entry.ModifiedText}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Entry.TimeLabel}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
            <toolkit:GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  AutomationProperties.Name="调整文件树宽度" ToolTipService.ToolTip="拖动调整文件树宽度" />
            <Border x:Name="GallerySurface" Grid.Column="2"
                    ContextRequested="Gallery_ContextRequested"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                <Grid x:Name="GalleryContent">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="GallerySurfaceFill" Grid.RowSpan="2" Background="{ThemeResource LayerFillColorDefaultBrush}" IsHitTestVisible="False" />
                    <ScrollViewer x:Name="GalleryScroller" Padding="12" Background="Transparent">
                        <ItemsRepeater x:Name="Gallery" VerticalCacheLength="2" HorizontalCacheLength="2" ElementPrepared="Gallery_ElementPrepared" ElementClearing="Gallery_ElementClearing">
                            <ItemsRepeater.Layout>
                                <layouts:MasonryLayout x:Name="Masonry" Spacing="10" DesiredColumnWidth="{x:Bind ThumbSize.Value, Mode=OneWay}" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate><controls:MediaTile DoubleTapped="Tile_DoubleTapped" Tapped="Tile_Tapped" ContextRequested="Tile_ContextRequested" /></DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="在左侧选择目录，或点击顶部的打开文件夹按钮" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                    <Canvas x:Name="MarqueeOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                        <Border x:Name="SelectionMarquee" BorderThickness="1" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}">
                            <Border.Background><SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.18" /></Border.Background>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="BrowserStatus" Grid.Row="2" Padding="14,4,10,4" ColumnSpacing="12" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{x:Bind GalleryState.Status, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Name="SelectionCountText" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconImage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="ThumbSize" Width="116" Minimum="120" Maximum="480" StepFrequency="20" Value="240"
                        ToolTipService.ToolTip="缩略图大小" AutomationProperties.Name="缩略图大小" ValueChanged="ThumbSize_ValueChanged" />
                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconImage}" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 查看器：共用右侧面板覆盖画面，不占用画面和底部控制栏的布局空间。 -->
        <Grid x:Name="Viewer" Grid.Row="1" Grid.RowSpan="2" Visibility="{x:Bind ToVisibility(ViewerState.IsOpen), Mode=OneWay}" Background="Transparent" RequestedTheme="Dark">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="ViewerStage" Grid.Column="0" SizeChanged="ViewerStage_SizeChanged">
                <ScrollViewer x:Name="ImageScroller" ViewChanged="ImageScroller_ViewChanged" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="20"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                              SizeChanged="ImageScroller_SizeChanged" DoubleTapped="ImageScroller_DoubleTapped">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                             MaxWidth="{x:Bind ImageScroller.ViewportWidth, Mode=OneWay}"
                             MaxHeight="{x:Bind ImageScroller.ViewportHeight, Mode=OneWay}">
                        <controls:QuarterTurnPanel x:Name="ImageRotation">
                        <Image x:Name="ViewerImage" Stretch="Uniform" ContextRequested="Viewer_ContextRequested"
                               PointerPressed="ViewerImage_PointerPressed" PointerMoved="ViewerImage_PointerMoved"
                               PointerReleased="ViewerImage_PointerReleased" PointerCaptureLost="ViewerImage_PointerReleased" />
                        </controls:QuarterTurnPanel>
                    </Viewbox>
                </ScrollViewer>

                <controls:AspectFitPanel x:Name="VideoSurface" Background="Transparent"
                                         Visibility="{x:Bind ViewerVideo.Visibility, Mode=OneWay}"
                                         Tapped="ViewerVideo_Tapped" DoubleTapped="ViewerVideo_DoubleTapped">
                    <MediaPlayerElement x:Name="ViewerVideo" Visibility="Collapsed" AreTransportControlsEnabled="False"
                                        AutoPlay="False" Stretch="Uniform" Background="Transparent" />
                </controls:AspectFitPanel>
                <Grid x:Name="AudioPresentation" Visibility="Collapsed" Background="#17191C" Padding="32"
                      Tapped="ViewerVideo_Tapped" DoubleTapped="ViewerVideo_DoubleTapped" ContextRequested="Viewer_ContextRequested">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Width="360" Spacing="18">
                            <Border Width="224" Height="224" CornerRadius="16" Background="#2A2D32" HorizontalAlignment="Center">
                                <Grid>
                                    <FontIcon x:Name="AudioPlaceholder" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAudio}" FontSize="80" Foreground="#B8C0CC" />
                                    <Image x:Name="AudioArtwork" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AudioTitle" FontSize="22" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AudioSubtitle" FontSize="14" Foreground="#B8C0CC" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Viewbox>
                </Grid>
                <controls:AspectFitPanel x:Name="MotionSurface" Visibility="Collapsed" IsHitTestVisible="False" Background="Transparent">
                    <MediaPlayerElement x:Name="MotionVideo" AreTransportControlsEnabled="False" AutoPlay="False"
                                        Stretch="Uniform" RenderTransformOrigin="0.5,0.5" />
                </controls:AspectFitPanel>
                <Border x:Name="MotionPhotoControls" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20" Background="#B32F2118" CornerRadius="12" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="MotionPhotoButton" Click="MotionPhoto_Click" Background="Transparent" BorderThickness="0"
                                Padding="12,8" CornerRadius="8" Foreground="White" AutomationProperties.Name="播放实况照片">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPlayMedia}" Foreground="White" />
                                <TextBlock x:Name="MotionPhotoText" Text="实况" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MotionSoundButton" Click="MotionSound_Click" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Center" Margin="4,0" Foreground="White">
                            <FontIcon x:Name="MotionSoundIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconVolume}" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ViewerMessage" Visibility="{x:Bind ToVisibility(ViewerState.HasMessage), Mode=OneWay}" Text="{x:Bind ViewerState.Message, Mode=OneWay}" TextWrapping="Wrap"
                           MaxWidth="640" Margin="64,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="White" IsHitTestVisible="False" />

                <Button x:Name="PrevButton" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewerState.CanPrevious, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}" Click="Prev_Click" ToolTipService.ToolTip="上一项 (←)">
                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPrevious}" FontSize="22" Foreground="White" />
                </Button>
                <Button x:Name="NextButton" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewerState.CanNext, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一项 (→)">
                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconNext}" FontSize="22" Foreground="White" />
                </Button>
            </Grid>

            <Border x:Name="FullScreenControlsHotspot" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                    Background="Transparent" Visibility="Collapsed"
                    PointerExited="FullScreenControls_PointerExited" />

            <!-- 单行控制栏；全屏时浮在画面上，侧面板不改变其宽度。 -->
            <Grid x:Name="ViewerBar" Grid.Row="2" Grid.Column="0" Padding="8,4" ColumnSpacing="6" Background="#1F2023"
                  BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" SizeChanged="ViewerBar_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid x:Name="VideoControls" Visibility="Collapsed" ColumnSpacing="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 视频画面由独立渲染窗口承载，不能叠加 XAML 箭头，上一项/下一项放在这里。 -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="VideoPreviousButton" Style="{StaticResource IconButtonStyle}" Click="Prev_Click" IsEnabled="{x:Bind ViewerState.CanPrevious, Mode=OneWay}"
                            ToolTipService.ToolTip="上一项 (PageUp)" AutomationProperties.Name="上一项">
                        <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconPreviousMedia}" />
                    </Button>
                    <Button x:Name="VideoPlayButton" Style="{StaticResource IconButtonStyle}" Click="VideoPlay_Click"
                            ToolTipService.ToolTip="播放 / 暂停 (空格)" AutomationProperties.Name="播放或暂停">
                        <FontIcon x:Name="VideoPlayIcon" Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconPauseMedia}" />
                    </Button>
                    <Button x:Name="VideoNextButton" Style="{StaticResource IconButtonStyle}" Click="Next_Click" IsEnabled="{x:Bind ViewerState.CanNext, Mode=OneWay}"
                            ToolTipService.ToolTip="下一项 (PageDown)" AutomationProperties.Name="下一项">
                        <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconNextMedia}" />
                    </Button>
                    <Button x:Name="VideoMuteButton" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="调整音量" AutomationProperties.Name="调整音量">
                        <FontIcon x:Name="VideoMuteIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconVolume}" />
                        <Button.Flyout>
                            <Flyout x:Name="VideoVolumeFlyout" Placement="Top" ShouldConstrainToRootBounds="True">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Padding" Value="12,4" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Grid Width="146" ColumnSpacing="10" RequestedTheme="Dark">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="VideoVolume" Minimum="0" Maximum="100" Value="100" StepFrequency="1"
                                            VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                            AutomationProperties.Name="音量" ValueChanged="VideoVolume_ValueChanged" />
                                    <TextBlock x:Name="VideoVolumeText" Grid.Column="1" Text="100%" VerticalAlignment="Center"
                                               TextAlignment="Right" FontSize="12" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="VideoPositionText" Grid.Column="1" Text="0:00" FontSize="12" VerticalAlignment="Center" Margin="4,0,8,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="VideoSeek" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center" AutomationProperties.Name="播放进度" ValueChanged="VideoSeek_ValueChanged" />
                <TextBlock x:Name="VideoDurationText" Grid.Column="3" Text="0:00" FontSize="12" VerticalAlignment="Center" Margin="8,0,6,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="VideoLoopText" Grid.Column="4" Visibility="Collapsed" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" ToolTipService.ToolTip="A-B 循环（\ 取消）" />
            </Grid>

                    <StackPanel x:Name="ViewerMetadata" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewerFormatText" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon x:Name="ViewerResolutionIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconResolution}" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBlock x:Name="ViewerResolutionText" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFileSize}" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBlock x:Name="ViewerSizeText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <StackPanel x:Name="ImageZoomPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Click="ZoomFit_Click" ToolTipService.ToolTip="适应窗口 (Ctrl+0)" AutomationProperties.Name="适应窗口">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFit}" />
                    </Button>
                    <DropDownButton Style="{StaticResource IconDropDownStyle}" ToolTipService.ToolTip="缩放比例" AutomationProperties.Name="缩放比例">
                        <TextBlock x:Name="ZoomPercentText" Text="适应窗口 · —" FontSize="12" MinWidth="112" TextAlignment="Center" />
                        <DropDownButton.Flyout><MenuFlyout x:Name="ZoomMenu" Placement="Top" /></DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource IconButtonStyle}" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小 (Ctrl+-)" AutomationProperties.Name="缩小">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconZoomOut}" />
                    </Button>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="-3.3" Maximum="4.3" StepFrequency="0.01" VerticalAlignment="Center"
                            IsThumbToolTipEnabled="False" AutomationProperties.Name="缩放" ValueChanged="ZoomSlider_ValueChanged" />
                    <Button Style="{StaticResource IconButtonStyle}" Click="ZoomIn_Click" ToolTipService.ToolTip="放大 (Ctrl+=)" AutomationProperties.Name="放大">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconZoomIn}" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="VideoAudioPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="FitVideoWindowButton" Style="{StaticResource IconButtonStyle}" Click="FitVideoWindow_Click" IsEnabled="False"
                            ToolTipService.ToolTip="窗口适应视频（同步调整浏览窗口）" AutomationProperties.Name="窗口适应视频">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFit}" />
                    </Button>
                    <Button x:Name="VideoRateButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="播放速度（C 加快 / X 减慢 / Z 恢复）"
                            AutomationProperties.Name="播放速度" Width="48" MinWidth="0" Height="30" Padding="6,0">
                        <TextBlock x:Name="VideoRateText" Text="1×" FontSize="13" Width="36" TextAlignment="Center" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="VideoRateMenu" Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="True"
                                        MenuFlyoutPresenterStyle="{StaticResource PlaybackRateMenuPresenterStyle}" />
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多播放选项">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconMore}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Top" Opening="VideoMoreMenu_Opening">
                                <MenuFlyoutItem x:Name="VideoCompactFitItem" Text="窗口适应视频" Click="FitVideoWindow_Click" />
                                <MenuFlyoutItem x:Name="VideoCompactRotateItem" Text="向右旋转 90°" Click="RotateMedia_Click" />
                                <MenuFlyoutSubItem x:Name="VideoCompactRateMenu" Text="播放速度" />
                                <MenuFlyoutSubItem x:Name="VideoTrackMenu" Text="音轨">
                                    <MenuFlyoutSubItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconVolume}" /></MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="VideoStepBackItem" Text="上一帧" KeyboardAcceleratorTextOverride="," Click="VideoStepBack_Click" />
                                <MenuFlyoutItem x:Name="VideoStepForwardItem" Text="下一帧" KeyboardAcceleratorTextOverride="." Click="VideoStepForward_Click" />
                                <MenuFlyoutSeparator x:Name="VideoFrameSeparator" />
                                <MenuFlyoutItem Text="设置 A 点" KeyboardAcceleratorTextOverride="[" Click="VideoLoopStart_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconLoop}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="设置 B 点" KeyboardAcceleratorTextOverride="]" Click="VideoLoopEnd_Click" />
                                <MenuFlyoutItem Text="取消 A-B 循环" KeyboardAcceleratorTextOverride="\" Click="VideoLoopClear_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="VideoScreenshotItem" Text="截图保存到视频目录" KeyboardAcceleratorTextOverride="Ctrl+E" Click="VideoScreenshot_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconScreenshot}" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                    <Button x:Name="RotateImageLeftButton" Style="{StaticResource IconButtonStyle}" Click="RotateImageLeft_Click" IsEnabled="False"
                            ToolTipService.ToolTip="向左旋转 90°" AutomationProperties.Name="向左旋转 90°">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconRotateLeft}" />
                    </Button>
                    <Button x:Name="RotateMediaButton" Style="{StaticResource IconButtonStyle}" Click="RotateMedia_Click" IsEnabled="False"
                            ToolTipService.ToolTip="向右旋转 90°" AutomationProperties.Name="向右旋转 90°">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconRotateRight}" />
                    </Button>
                    <ToggleButton x:Name="FlipImageToggle" Style="{StaticResource IconToggleButtonStyle}" Click="FlipImage_Click" IsEnabled="False"
                                  ToolTipService.ToolTip="水平翻转" AutomationProperties.Name="水平翻转">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFlipHorizontal}" />
                    </ToggleButton>
                </StackPanel>
                <ToggleButton x:Name="DetailsToggle" Grid.Column="2" Style="{StaticResource IconToggleButtonStyle}" Click="DetailsToggle_Click"
                                  ToolTipService.ToolTip="详细信息 (I)" AutomationProperties.Name="详细信息">
                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconInfo}" />
                    </ToggleButton>
                <ToggleButton x:Name="PlaylistToggle" Grid.Column="3" Style="{StaticResource IconToggleButtonStyle}" Click="PlaylistToggle_Click"
                              ToolTipService.ToolTip="播放列表 (L)" AutomationProperties.Name="播放列表">
                    <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPlaylist}" />
                </ToggleButton>
                <Button x:Name="ViewerFullScreenButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="ViewerFullScreen_Click"
                        ToolTipService.ToolTip="全屏 (F11)" AutomationProperties.Name="全屏">
                    <FontIcon x:Name="ViewerFullScreenIcon" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconFullScreen}" />
                </Button>
            </Grid>

            <!-- 共用悬浮外壳与画面四边留出间距，内容面板保持透明以露出圆角。 -->
            <Grid x:Name="ViewerSidePanel" Grid.Row="0" Width="300"
                  HorizontalAlignment="Right" Visibility="Collapsed" Margin="12"
                  Background="#202123" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12">
                <Grid.Shadow><ThemeShadow x:Name="ViewerPanelShadow" /></Grid.Shadow>
                <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="16,14,10,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="详细信息" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="DetailsToggle_Click"
                                ToolTipService.ToolTip="收起详细信息 (I)" AutomationProperties.Name="收起详细信息">
                            <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPanelRight}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="16,16,16,8" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="DetailsContent" />
                    </ScrollViewer>
                </Grid>


                <Grid x:Name="PlaylistPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="16,14,10,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="播放列表" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewerState.Counter, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <ToggleButton x:Name="PlaylistThumbnailsToggle" IsChecked="True" Click="PlaylistThumbnails_Click"
                                          Style="{StaticResource IconToggleButtonStyle}" ToolTipService.ToolTip="隐藏缩略图" AutomationProperties.Name="隐藏缩略图">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconImage}" />
                            </ToggleButton>
                            <Button Style="{StaticResource IconButtonStyle}" Click="PlaylistToggle_Click"
                                    ToolTipService.ToolTip="收起播放列表" AutomationProperties.Name="收起播放列表">
                                <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconPanelRight}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="PlaylistView" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" Margin="6,0,6,8" Padding="0,0,0,4"
                              ItemClick="PlaylistView_ItemClick" ContainerContentChanging="PlaylistView_ContainerContentChanging">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Width="88" Height="50" CornerRadius="4" Background="#2A2B2F">
                                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconImage}" FontSize="18" Visibility="{x:Bind IsImage}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <FontIcon Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAudio}" FontSize="22" Visibility="{x:Bind IsAudio}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border Visibility="{x:Bind IsVideo}" Background="#99000000" CornerRadius="9" Width="18" Height="18"
                                                Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconPlay}" FontSize="9"
                                                      Foreground="White" Margin="1,0,0,0" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
