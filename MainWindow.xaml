<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layouts="using:Fallery.Layouts"
    xmlns:models="using:Fallery.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Fallery">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Fallery"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Foreground="{ThemeResource TextFillColorPrimaryBrush}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/FalleryTitleBar.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 工具栏：后退 / 上级 / 面包屑 / 缩略图大小 -->
        <Grid Grid.Row="1" Padding="8,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButtonStyle}" Click="Back_Click" ToolTipService.ToolTip="后退 (S)">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="Up_Click" ToolTipService.ToolTip="上级目录 (W)">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <BreadcrumbBar x:Name="Breadcrumb" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                           ItemClicked="Breadcrumb_ItemClicked" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="ThumbSize" Width="140" Minimum="120" Maximum="480" StepFrequency="20" Value="240"
                        ToolTipService.ToolTip="缩略图大小" />
                <ComboBox x:Name="ThemeSelector" Width="128" VerticalAlignment="Center"
                          AutomationProperties.Name="外观主题" ToolTipService.ToolTip="外观主题"
                          SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" Tag="Default" />
                    <ComboBoxItem Content="亮色" Tag="Light" />
                    <ComboBoxItem Content="暗色" Tag="Dark" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 主区域：文件树 | 瀑布流 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" SelectionMode="Single" Padding="0,4"
                      Expanding="FolderTree_Expanding" ItemInvoked="FolderTree_ItemInvoked" />

            <toolkit:GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="8"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  AutomationProperties.Name="调整文件树宽度"
                                  ToolTipService.ToolTip="拖动调整文件树宽度" />

            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <ScrollViewer x:Name="GalleryScroller" Padding="8">
                    <ItemsRepeater x:Name="Gallery"
                                   ElementPrepared="Gallery_ElementPrepared"
                                   ElementClearing="Gallery_ElementClearing">
                        <ItemsRepeater.Layout>
                            <layouts:MasonryLayout x:Name="Masonry" Spacing="6"
                                                   DesiredColumnWidth="{x:Bind ThumbSize.Value, Mode=OneWay}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Grid CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                      DoubleTapped="Tile_DoubleTapped" ToolTipService.ToolTip="{x:Bind Name}">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border Visibility="{x:Bind IsVideo}" Background="#99000000" CornerRadius="4"
                                            Padding="5,2" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="12,4" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="在左侧选择一个文件夹" />

        <!-- 查看器：覆盖整个窗口，图片和视频都在这里播放 -->
        <Grid x:Name="Viewer" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="#F2101010" RequestedTheme="Dark">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButtonStyle}" Click="CloseViewer_Click" ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                </Button>
                <TextBlock x:Name="ViewerTitle" Grid.Column="1" VerticalAlignment="Center" Foreground="White"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ViewerCounter" Grid.Column="2" VerticalAlignment="Center" Foreground="#AAAAAA" />
            </Grid>

            <ScrollViewer x:Name="ImageScroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="20"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          SizeChanged="ImageScroller_SizeChanged" DoubleTapped="ImageScroller_DoubleTapped">
                <Image x:Name="ViewerImage" Stretch="Uniform" />
            </ScrollViewer>

            <MediaPlayerElement x:Name="ViewerVideo" Grid.Row="1" Visibility="Collapsed"
                                AreTransportControlsEnabled="True" AutoPlay="True" />

            <Button Grid.Row="1" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}" Click="Prev_Click" ToolTipService.ToolTip="上一项 (←)">
                <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="White" />
            </Button>
            <Button Grid.Row="1" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一项 (→)">
                <FontIcon Glyph="&#xE76C;" FontSize="20" Foreground="White" />
            </Button>
        </Grid>
    </Grid>
</Window>
