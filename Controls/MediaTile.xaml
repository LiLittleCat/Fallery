<UserControl
    x:Class="Fallery.Controls.MediaTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="True">
    <Grid CornerRadius="6" Padding="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="CaptionRow" Height="22" /></Grid.RowDefinitions>
        <FontIcon x:Name="FolderPlaceholder" Glyph="&#xE8B7;" FontSize="48"
                  Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="FailureText" Text="无法加载预览" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="180"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="LoadingText" Text="正在加载预览…" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border CornerRadius="3"><Image x:Name="PreviewImage" Stretch="UniformToFill" /></Border>
        <Grid x:Name="FolderStack" Visibility="Collapsed" Margin="10,8,10,14" IsHitTestVisible="False">
            <Border x:Name="BackCover" Margin="14,2,2,24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="5" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="7" /></Border.RenderTransform>
                <Border CornerRadius="3"><Image x:Name="BackCoverImage" Stretch="UniformToFill" Opacity="0.85" /></Border>
            </Border>
            <Border x:Name="MiddleCover" Margin="0,12,14,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="5" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-5" /></Border.RenderTransform>
                <Border CornerRadius="3"><Image x:Name="MiddleCoverImage" Stretch="UniformToFill" Opacity="0.95" /></Border>
            </Border>
            <Border Margin="6,24,6,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="5">
                <Border CornerRadius="3"><Image x:Name="FrontCoverImage" Stretch="UniformToFill" /></Border>
            </Border>
        </Grid>
        <Border x:Name="FolderBadge" Visibility="Collapsed" Background="#CC20252B" CornerRadius="4" Padding="6,3"
                Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="#78C9EA" />
                <TextBlock Text="文件夹" FontSize="10" Foreground="White" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="MediaName" Grid.Row="1" FontSize="12" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border x:Name="FolderFooter" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#58ABCE" VerticalAlignment="Center" />
                <TextBlock x:Name="FolderName" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border x:Name="VideoBadge" Visibility="Collapsed" Background="#99000000" CornerRadius="4"
                Padding="5,3" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" />
        </Border>
        <Border x:Name="SelectionOutline" Grid.RowSpan="2" Margin="-6" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>
