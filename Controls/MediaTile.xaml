<UserControl
    x:Class="Fallery.Controls.MediaTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="True"
    PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
    PointerMoved="Tile_PointerMoved"
    PointerCanceled="Tile_PointerExited" PointerCaptureLost="Tile_PointerExited">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileFolderBrush" Color="#E8A923" />
                    <SolidColorBrush x:Key="TileImageBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TileImageStrokeBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="TileImageTextBrush" Color="#5C5C5C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileFolderBrush" Color="#F2C24F" />
                    <SolidColorBrush x:Key="TileImageBrush" Color="#2B2C2F" />
                    <SolidColorBrush x:Key="TileImageStrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="TileImageTextBrush" Color="#9B9B9B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 内边距 5 + 描边 1 与 MasonryGeometry 的 imageInset 6 对应，改动时两边同步。 -->
    <Grid x:Name="CardRoot" CornerRadius="8" Padding="5" BorderThickness="1"
          Background="{ThemeResource TileImageBrush}" BorderBrush="{ThemeResource TileImageStrokeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardStates">
                <VisualState x:Name="ImageCard" />
                <VisualState x:Name="SelectedCard">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="CardRoot.BorderBrush" Value="Transparent" />
                        <Setter Target="MediaName.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="VideoMark.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="FolderName.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <!-- 无卡片背景：图片直接铺满格子，选中时只描一圈强调色边框。 -->
                <VisualState x:Name="ImagePlain">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="Transparent" />
                        <Setter Target="CardRoot.BorderThickness" Value="0" />
                        <Setter Target="CardRoot.Padding" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPlain">
                    <VisualState.Setters>
                        <Setter Target="CardRoot.Background" Value="Transparent" />
                        <Setter Target="CardRoot.Padding" Value="0" />
                        <Setter Target="CardRoot.BorderThickness" Value="2" />
                        <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="MediaName.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="VideoMark.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="FolderName.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="CaptionRow" Height="22" /></Grid.RowDefinitions>
        <Border x:Name="HoverOverlay" Grid.RowSpan="2" Margin="-5" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Visibility="Collapsed" IsHitTestVisible="False" />
        <TextBlock x:Name="FailureText" Text="无法加载预览" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="180"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="LoadingText" Text="正在加载预览…" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border CornerRadius="4"><Image x:Name="PreviewImage" Stretch="UniformToFill" /></Border>
        <FontIcon x:Name="AudioPlaceholder" Style="{StaticResource FluentIcon}" Glyph="{StaticResource IconAudio}"
                  Visibility="Collapsed" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
        <Border CornerRadius="4" IsHitTestVisible="False"><Grid x:Name="HoverVideoHost" /></Border>
        <!-- 叠图外沿贴近 5:4 画布，后两张反向交叉，前图摆正以保持主体清楚。 -->
        <Grid x:Name="FolderArtwork" Visibility="Collapsed" CornerRadius="4" IsHitTestVisible="False">
            <Viewbox Margin="24" Stretch="Uniform">
                <FontIcon x:Name="FolderPlaceholder" Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconFolderFilled}"
                          FontSize="80" Foreground="{ThemeResource TileFolderBrush}" />
            </Viewbox>
            <Viewbox Stretch="Uniform">
                <Grid x:Name="FolderStack" Visibility="Collapsed" Width="200" Height="160">
                    <Border x:Name="BackCover" Width="166" Height="122" Margin="20,16,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                            Background="#FFFFFF" Padding="1.5" CornerRadius="4">
                        <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
                        <Border CornerRadius="2.5"><Image x:Name="BackCoverImage" Stretch="UniformToFill" /></Border>
                    </Border>
                    <Border x:Name="MiddleCover" Width="166" Height="122" Margin="14,16,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                            Background="#FFFFFF" Padding="1.5" CornerRadius="4">
                        <Border.RenderTransform><RotateTransform Angle="10" /></Border.RenderTransform>
                        <Border CornerRadius="2.5"><Image x:Name="MiddleCoverImage" Stretch="UniformToFill" /></Border>
                    </Border>
                    <Border x:Name="FrontCover" Width="166" Height="116" Margin="17,38,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#FFFFFF" Padding="1.5" CornerRadius="4">
                        <Border CornerRadius="2.5"><Image x:Name="FrontCoverImage" Stretch="UniformToFill" /></Border>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
        <Grid x:Name="MediaCaption" Grid.Row="1" Margin="3,5,3,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="MediaName" FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Foreground="{ThemeResource TileImageTextBrush}" />
            <FontIcon x:Name="VideoMark" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconPlay}"
                      FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TileImageTextBrush}" />
        </Grid>
        <Border x:Name="FolderFooter" Grid.Row="1" Visibility="Collapsed" Margin="2,5,2,0" VerticalAlignment="Center">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconFolderFilled}" FontSize="14"
                          Foreground="{ThemeResource TileFolderBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FolderName" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <!-- 只在隐藏文件名时显示；显示文件名时视频标记在文件名末尾。 -->
        <Border x:Name="VideoBadge" Visibility="Collapsed" Background="#99000000" CornerRadius="12" Width="24" Height="24"
                Margin="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <!-- 三角形的视觉重心偏左，右移 1 像素才显得居中。 -->
            <FontIcon x:Name="VideoBadgeIcon" Style="{StaticResource FluentIconFilled}" Glyph="{StaticResource IconPlay}" FontSize="12" Foreground="White"
                      Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
